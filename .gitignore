# Runtime data: mail, accounts, keys, settings (contains your Cloudflare token)
mailer-data/
/data/
# Built binary, and the data folder compose.yaml uses where LOCALAPPDATA isn't set
/mailer
# Never commit environment files; mailer keeps its settings in its data folder
.env
# Desktop app builds from before the container
/builds/
# Windows icon resources the desktop build generated
*.syso
