# Copy to .env next to compose.yaml and fill in what you need. .env is
# git-ignored: keys and tokens belong here, never in compose.yaml.

# Folder for mail, accounts, keys and settings. The installer sets ./data.
# MAILER_DATA_DIR=./data

# This server's name on your tailnet (mail apps connect to <name>.<tailnet>.ts.net).
# TS_HOSTNAME=mail

# A Tailscale auth key (https://tailscale.com/kb/1085/auth-keys) signs the
# server in to your tailnet without the dashboard link.
# TS_AUTHKEY=

# 1 logs every command mail apps send (passwords hidden).
# MAILER_TRACE=0

# Overrides the IMAP extensions advertised. Empty means the default set.
# MAILER_IMAP_CAPS=
